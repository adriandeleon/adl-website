---
import Layout from "../../layouts/Layout.astro";
import { posts, shortDate } from "../../lib/content";
import { site } from "../../lib/site";

const all = await posts();
---

<Layout
  title={`Blog — ${site.name}`}
  description="Writing about software, tools, and the things I build."
  ogImage="og/blog.png"
>
  <main class="doc">
    <div class="head">
      <h1>Blog</h1>
      <a class="feed" href="/blog/rss.xml">RSS</a>
    </div>
    <p class="lead">Writing about software, tools, and the things I build.</p>

    {all.length === 0 && <p class="empty">No posts yet.</p>}

    <ul class="posts">
      {
        all.map((p) => (
          <li>
            <a href={`/blog/${p.id}`} class="post-title">
              {p.data.title}
            </a>
            <p class="post-meta">
              {shortDate(p.data.date)}
              {p.data.tags.length > 0 && <span> · {p.data.tags.join(", ")}</span>}
              {p.data.draft && <span class="draft-pill">Draft</span>}
            </p>
            {p.data.description && <p class="post-desc">{p.data.description}</p>}
          </li>
        ))
      }
    </ul>
  </main>
</Layout>

<style>
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .head h1 {
    margin-bottom: 0;
  }
  .feed {
    font-size: 0.8rem;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
  }
  .feed:hover {
    color: var(--text);
    border-color: var(--accent);
    text-decoration: none;
  }
  .lead {
    color: var(--muted);
    margin: 0.5rem 0 2.5rem;
  }
  .empty {
    color: var(--faint);
  }
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .posts li {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border-soft);
  }
  .post-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
  }
  .post-meta {
    color: var(--faint);
    font-size: 0.85rem;
    margin: 0.25rem 0 0;
  }
  .post-desc {
    color: var(--muted);
    margin: 0.5rem 0 0;
  }
</style>

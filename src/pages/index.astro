---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import avatar from "../assets/avatar.jpg";
import { posts, projects, shortDate } from "../lib/content";
import { projectIcon } from "../lib/icons";
import { site, socials } from "../lib/site";

// The home page is a shop window, not an archive: a few of each, with a link
// to the full list. Change the slice sizes and that's the whole knob.
const recentPosts = (await posts()).slice(0, 5);
const topProjects = (await projects()).slice(0, 4);
---

<Layout>
  <main class="doc">
    <section class="hero">
      {/* Decorative: the name it sits beside is already text, so announcing
          the portrait too would just repeat it to a screen reader. */}
      <Image
        class="avatar"
        src={avatar}
        alt=""
        width={128}
        height={128}
        densities={[1, 2]}
        loading="eager"
      />
      <div class="hero-text">
        <h1>{site.name}</h1>
        <p class="lead">{site.tagline}</p>
        <p class="hero-links">
        {
          socials.map((s) => (
            <a
              href={s.href}
              target={s.href.startsWith("http") ? "_blank" : undefined}
              rel={s.href.startsWith("http") ? "noopener noreferrer" : undefined}
            >
              {s.label}
            </a>
          ))
        }
        </p>
      </div>
    </section>

    {
      topProjects.length > 0 && (
        <section>
          <div class="section-head">
            <h2>Projects</h2>
            <a href="/projects">All projects →</a>
          </div>
          <ul class="list">
            {topProjects.map((p) => {
              const icon = projectIcon(p.id);
              return (
                <li class="project-row">
                  {icon ? (
                    <Image class="project-icon" src={icon} alt="" width={32} height={32} densities={[1, 2]} />
                  ) : (
                    /* Keeps the text column aligned when a project has no
                       icon, instead of letting that row shift left. */
                    <span class="project-icon" aria-hidden="true" />
                  )}
                  <div class="project-body">
                    <a href={`/projects/${p.id}`} class="item-title">
                      {p.data.title}
                    </a>
                    {p.data.status && <span class="status-pill">{p.data.status}</span>}
                    <p class="item-desc">{p.data.summary}</p>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section>
          <div class="section-head">
            <h2>Writing</h2>
            <a href="/blog">All posts →</a>
          </div>
          <ul class="list">
            {recentPosts.map((p) => (
              <li>
                <a href={`/blog/${p.id}`} class="item-title">
                  {p.data.title}
                </a>
                <p class="item-desc">
                  <span class="date">{shortDate(p.data.date)}</span>
                  {p.data.description && <span> — {p.data.description}</span>}
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</Layout>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    padding: 2rem 0 1rem;
  }
  .avatar {
    flex: none;
    width: 128px;
    height: 128px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border);
  }
  .hero-text {
    min-width: 0;
  }
  .hero h1 {
    margin-top: 0;
    margin-bottom: 0.3rem;
  }
  /* Stack on narrow screens: side by side leaves the tagline about twelve
     characters wide on a phone. */
  @media (max-width: 560px) {
    .hero {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.1rem;
    }
    .avatar {
      width: 96px;
      height: 96px;
    }
  }
  .lead {
    color: var(--muted);
    font-size: 1.1rem;
    margin: 0;
  }
  .hero-links {
    display: flex;
    gap: 1.2rem;
    margin: 1.2rem 0 0;
    font-size: 0.9rem;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--border-soft);
    margin-top: 3rem;
  }
  .section-head h2 {
    margin: 0 0 0.6rem;
    border: 0;
  }
  .section-head a {
    font-size: 0.85rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .list li {
    padding: 1rem 0;
    border-bottom: 1px solid var(--border-soft);
  }
  .project-row {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }
  .project-icon {
    flex: none;
    width: 32px;
    height: 32px;
    /* No border-radius: every icon already rounds its own corners against a
       transparent surround, so clipping again just shaves them. */
    /* Nudge down so the icon's optical centre lines up with the title's
       cap height rather than its line box. */
    margin-top: 0.15rem;
  }
  .project-body {
    min-width: 0;
  }
  .item-title {
    font-weight: 700;
    color: var(--text);
  }
  .item-desc {
    color: var(--muted);
    margin: 0.3rem 0 0;
    font-size: 0.92rem;
  }
  .date {
    color: var(--faint);
    font-family: var(--mono);
    font-size: 0.85em;
  }
</style>

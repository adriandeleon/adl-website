---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { projectIcon } from "../../lib/icons";
import { projectLinks } from "../../lib/links";
import { projectScreenshot } from "../../lib/screenshots";
import { site } from "../../lib/site";
import { ogFor } from "../../lib/og";

export async function getStaticPaths() {
  // Unfiltered for the same reason as the blog: a draft is previewable at its
  // URL, just unlisted and noindexed.
  const all = await getCollection("projects");
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, status, tech, year, draft } = entry.data;
const icon = projectIcon(entry.id);
const screenshot = projectScreenshot(entry.id);
---

<Layout
  title={`${title} — ${site.name}`}
  description={summary}
  ogImage={ogFor("project", entry.id)}
  noindex={draft}
>
  <article class="doc" data-pagefind-body data-pagefind-meta="kind:Project">
    <p class="back" data-pagefind-ignore><a href="/projects">← Projects</a></p>
    <div class="title-row">
      {icon && (
        <Image
          class="title-icon"
          src={icon}
          alt=""
          width={48}
          height={48}
          densities={[1, 2]}
          loading="eager"
        />
      )}
      <h1>
        {title}
        {status && <span class="status-pill">{status}</span>}
        {draft && <span class="draft-pill">Draft</span>}
      </h1>
    </div>
    <p class="lead">{summary}</p>

    <dl class="facts" data-pagefind-ignore>
      {year && (
        <>
          <dt>Year</dt>
          <dd>{year}</dd>
        </>
      )}
      {tech.length > 0 && (
        <>
          <dt>Built with</dt>
          <dd>{tech.join(", ")}</dd>
        </>
      )}
      {
        projectLinks(entry.data).map((l) => (
          <>
            <dt>{l.label}</dt>
            <dd>
              <a href={l.href} target="_blank" rel="noopener noreferrer">
                {l.href.replace(/^https?:\/\//, "")}
              </a>
            </dd>
          </>
        ))
      }
    </dl>

    {screenshot && (
      <Image
        class="project-screenshot"
        src={screenshot.src}
        alt={screenshot.alt}
        width={980}
        densities={[1, 2]}
      />
    )}

    <Content />
  </article>
</Layout>

<style>
  .back {
    margin: 0 0 1rem;
    font-size: 0.9rem;
  }
  .title-row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .title-icon {
    flex: none;
    width: 48px;
    height: 48px;
    /* The source icons round their own corners; see index.astro. */
  }
  /* The global .doc h1 carries a top margin that would push the heading off
     the icon's centre line. */
  .title-row h1 {
    margin-top: 0;
    margin-bottom: 0;
  }
  .facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.4rem 1.2rem;
    margin: 0 0 2.5rem;
    padding: 1rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-soft);
    font-size: 0.9rem;
  }
  .facts dt {
    color: var(--faint);
  }
  .facts dd {
    margin: 0;
    color: var(--muted);
  }
  .project-screenshot {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 0 2.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-soft);
  }
</style>
